[Unit]
Description=GNOME AirDrop receiver (experimental Intel AX211 backend)
After=NetworkManager.service bluetooth.service
Wants=bluetooth.service

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/bin/python3 /opt/gnome-airdrop/bin/service.py run
ExecStopPost=/usr/bin/python3 /opt/gnome-airdrop/bin/service.py recover
TimeoutStartSec=60
TimeoutStopSec=60
SuccessExitStatus=130 143
KillMode=mixed
RuntimeDirectory=gnome-airdrop
RuntimeDirectoryMode=0755
UMask=0077
LimitCORE=0
Restart=no
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Intentionally no [Install] section: receiving never starts at boot.
