<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>GNOME AirDrop</vendor>
  <action id="io.github.pokys.gnome-airdrop.control">
    <description>Manage AirDrop receiving</description>
    <message>Pro zapnutí nebo vypnutí příjmu AirDrop ověřte svou totožnost.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/gnome-airdrop/bin/control.py</annotate>
  </action>
</policyconfig>
